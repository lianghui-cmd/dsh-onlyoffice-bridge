{
  "name": "dsh-onlyoffice-bridge",
  "version": "0.4.0",
  "description": "DeepSeek Harness bridge plugin for ONLYOFFICE Document Server | 打开/编辑/生成/转换/对比/锁/批量 共 22 个 Agent 工具（文档依赖内置，重装不掉依赖）",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    ".env.example",
    "tsconfig.json",
    "types/*.d.ts"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "icon": "./icon.svg",
  "dsh": {
    "title": "OnlyOffice Bridge",
    "author": "Self",
    "tags": [
      "office",
      "document",
      "onlyoffice",
      "docx",
      "xlsx",
      "read-doc",
      "batch",
      "diff",
      "lock",
      "template",
      "image-insert"
    ],
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "docx": "9.15.1",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "xlsx": "0.18.5",
    "diff": "7.0.0",
    "marked": "15.0.0"
  },
  "vendoredDependencies": {
    "docx": "9.15.1",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "xlsx": "0.18.5",
    "diff": "7.0.0",
    "marked": "15.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node --import ./test/register.mjs test/all.mjs && node test/validate-patch.test.mjs",
    "test:patch": "node test/validate-patch.test.mjs",
    "vendor": "node scripts/vendor-deps.mjs",
    "vendor:check": "node scripts/vendor-deps.mjs --dry-run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "MIT"
}
