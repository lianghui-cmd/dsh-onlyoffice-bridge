# dsh-onlyoffice-bridge 环境配置模板
# 复制为 .env 后填写；也可以用任意进程管理器注入同名环境变量（DSH 桌面端不会自动读取 .env，
# 详见 README「配置」一节）。宿主进程已经存在的同名环境变量优先于 .env。

# ---------------------------------------------------------------------------
# 1. ONLYOFFICE Document Server
# ---------------------------------------------------------------------------
# DS 地址：插件向这个地址拼接 /web-apps/apps/api/documents/editor.html 生成编辑链接，
# 并调用 /coauthoring/CommandService.ashx 导出 PDF。
ONLYOFFICE_DS_URL=http://127.0.0.1:8080

# ONLYOFFICE local.json 里配置的 JWT 密钥（outbox/secret 或 services.CoAuthoring.secret.*），
# 必须与 DS 完全一致：插件用它签名，DS 用它验签。
ONLYOFFICE_SECRETS=replace-me-secret-key
# 旧版 DS 用单密钥字段名；两者都支持，ONLYOFFICE_SECRET 优先级更高。留空即可。
# ONLYOFFICE_SECRET=

# docker run 时如果 ONLYOFFICE_JWT_HEADER 改成了自定义请求头，这里保持一致。
# ONLYOFFICE_JWT_HEADER=Authorization
# 已带 "Bearer " 前缀时设为 true。
# ONLYOFFICE_JWT_HEADER_PREFIXED=false

# ---------------------------------------------------------------------------
# 2. DSH 对 DS 的访问地址（最容易出错的一项）
# ---------------------------------------------------------------------------
# 是「DS 容器 / DS 主机」能访问到 DSH 的地址，不是浏览器地址：
#   - DS 与 DSH 在同一台机器（DS 非 docker）：http://127.0.0.1:11006
#   - DS 跑在 docker：必须写宿主机局域网 IP 或 host.docker.internal，
#     例如 http://192.168.1.20:11006 或 http://host.docker.internal:11006
#   - 留空则由插件在运行时用 ctx.webServer.getOrigin() 自动探测；
#     但 DSH 绑定在 127.0.0.1 时自动探测出来的地址 DS 容器访问不到，需要显式配置。
# DSH_PUBLIC_URL=http://127.0.0.1:11006

# 生成编辑链接时使用的浏览器可达地址（可选，仅多网卡 / 反向代理时需要）。
# EDITOR_DS_URL=https://office.example.com

# ---------------------------------------------------------------------------
# 3. 缓存
# ---------------------------------------------------------------------------
# 缓存目录；相对路径按 DSH 进程的工作目录解析。默认 <DSH_HOME>/onlyoffice（当前用户目录）。
# STORAGE_DIR=../../data/onlyoffice

# 缓存过期时间（小时）。文档被编辑保存或重新打开时会刷新修改时间。
CACHE_TTL_HOUR=24

# 自动清理间隔（分钟），0 = 随缓存过期一起清扫。
CACHE_CLEAN_INTERVAL_MIN=360

# 单次上传 / 回调下载的大小上限（MiB）。
MAX_FILE_MB=128

# ---------------------------------------------------------------------------
# 4. 访问控制
# ---------------------------------------------------------------------------
# 除同源 Referer 校验外，额外允许的网页来源（ONLYOFFICE 编辑器域名一般不需要，
# DS 拉取和保存回调用的是服务端请求）。逗号分隔，例如：
# ALLOWED_ORIGINS=https://office.example.com
